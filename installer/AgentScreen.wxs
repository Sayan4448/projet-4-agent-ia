<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Projet 4, agent IA"
           Language="1033"
           Version="1.8.0.0"
           Manufacturer="AgentScreen"
           UpgradeCode="7C5E2B9A-4F1D-4E38-9A66-2D8C0B5A1F30">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="Agentic desktop assistant (Gemini, OpenAI, Claude, Groq, DeepSeek, OpenRouter)"
             Manufacturer="AgentScreen" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <Feature Id="Main" Title="Projet 4, agent IA" Level="1">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <UI>
      <UIRef Id="WixUI_InstallDir" />
    </UI>
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <InstallExecuteSequence>
      <Custom Action="LaunchAppAfterInstall" After="InstallFinalize">NOT Installed</Custom>
    </InstallExecuteSequence>
    <CustomAction Id="LaunchAppAfterInstall"
                  FileKey="AgentScreenExe"
                  ExeCommand=""
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="AgentScreen" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuFolder" Name="Projet 4, agent IA" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AppFiles">
      <Component Directory="INSTALLFOLDER" Id="MainExe" Guid="A1B2C3D4-1111-4E38-9A66-2D8C0B5A1F30">
        <File Id="AgentScreenExe" Source="..\dist\AgentScreen.exe" KeyPath="yes" Checksum="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER" Id="Shortcuts" Guid="A1B2C3D4-3333-4E38-9A66-2D8C0B5A1F30">
        <RegistryValue Root="HKCU"
                       Key="Software\AgentScreen"
                       Name="shortcuts"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <Shortcut Id="StartMenuShortcut"
                  Directory="AppMenuFolder"
                  Name="Projet 4, agent IA"
                  Description="Agentic desktop assistant"
                  Target="[INSTALLFOLDER]AgentScreen.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon"
                  Advertise="no" />
        <Shortcut Id="DesktopShortcut"
                  Directory="DesktopFolder"
                  Name="Projet 4, agent IA"
                  Description="Agentic desktop assistant"
                  Target="[INSTALLFOLDER]AgentScreen.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon"
                  Advertise="no" />
      </Component>
      <Component Directory="AppMenuFolder" Id="MenuCleanup" Guid="A1B2C3D4-2222-4E38-9A66-2D8C0B5A1F30">
        <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\AgentScreen"
                       Name="menuFolder"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
